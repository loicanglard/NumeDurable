# Example environment variables for NumeDurable
# Copy to .env and fill the values (DO NOT commit .env)

# Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=true

# Secret - set a strong random value in production
SECRET_KEY=replace_with_a_strong_secret_key

# ========== DATABASE CONFIGURATION ==========
# LOCAL DEVELOPMENT: Use SQLite (default)
# DB_TYPE=sqlite
# DATABASE=database/trailmemoire.db

# PRODUCTION / SUPABASE: Use PostgreSQL
# 1. Get credentials from Supabase > SQL Editor > Connection String
# 2. Set DB_TYPE and DATABASE_URL
# 3. Run: flask --app app init-db
#
# DB_TYPE=postgresql
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rjjtlfncjzenogpnpeor.supabase.co:5432/postgres
#
# Note: Replace [YOUR-PASSWORD] with your actual Supabase password
# Note: If using Session Pooler (recommended for many connections):
#       postgresql://[user]:[password]@[host].pooler.supabase.co:6543/postgres

# Database (optional)
# DATABASE=sqlite:///path/to/trailmemoire.db

# Session cookie settings
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Rate limiter settings (optional)
# RATELIMIT_STORAGE_URL=memory://
