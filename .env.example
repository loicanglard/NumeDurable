# Example environment variables for NumeDurable
# Copy to .env and fill the values (DO NOT commit .env)

# Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=true

# Secret - set a strong random value in production
SECRET_KEY=replace_with_a_strong_secret_key

# Database (optional)
# DATABASE=sqlite:///path/to/trailmemoire.db

# Session cookie settings
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Rate limiter settings (optional)
# RATELIMIT_STORAGE_URL=memory://
